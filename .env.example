# Hombo3 3.0 Robot Control Center
# Copy to .env and change only local addresses/credentials.

APP_HOST=0.0.0.0
APP_PORT=8088

# ESP32-S3-DevKitC-1 N16R8
ESP32_BASE_URL=http://192.168.1.33
ESP32_AUDIO_HOST=192.168.1.33
ESP32_AUDIO_PORT=3333
ESP32_REQUEST_TIMEOUT_S=1.5
ESP32_API_TOKEN=

# Ollama / Hermes on Huananzhi
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=hf.co/bartowski/NousResearch_Hermes-4-14B-GGUF:Q4_K_M
OLLAMA_TIMEOUT_S=180

# REGGO camera
CAMERA_RTSP_URL=
CAMERA_ONVIF_HOST=192.168.1.62
CAMERA_ONVIF_PORT=8000
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_PROFILE_MODE=low
CAMERA_MJPEG_WIDTH=640
CAMERA_MJPEG_FPS=10
CAMERA_JPEG_QUALITY=55
CAMERA_AUDIO_ENABLED=true
CAMERA_HFOV_DEG=72
CAMERA_PAN_INVERT=false
CAMERA_TILT_INVERT=false
CAMERA_AUTOFOCUS=true
CAMERA_VIDEO_BACKEND=auto
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_STALL_TIMEOUT_S=2.5

# Local YOLO on Acer
VISION_PROVIDER=acer
VISION_MODEL=yolo11n.pt
VISION_MODEL_PATH=
VISION_INTERVAL_S=1.0
VISION_TIMEOUT_S=90
VISION_MIN_CONFIDENCE=0.45
VISION_IMGSZ=416
VISION_DEVICE=cpu
VISION_CPU_THREADS=3

# Dashboard estimates
WHEEL_DIAMETER_MM=65
TRACK_WIDTH_MM=145
HEAD_PAN_RANGE_DEG=300
HEAD_PTZ_STEP_DEG=18
MOTOR_ESTIMATED_MAX_RPM=200
DRIVE_PWM_LIMIT=255

# Telemetry/logging
TELEMETRY_INTERVAL_S=0.25
TELEMETRY_LOG_INTERVAL_S=1.0
