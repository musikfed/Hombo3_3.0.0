# Hombo3 ↔ PegineLab WIFICAM T23N (SD-only Thingino)
# Merge these CAMERA_* keys into the local .env file. Do not commit .env.
# CAMERA_IP is the address of the real camera on your LAN (example below).
#
# Fast path: one RTSP decoder on Acer, newest JPEG via WS to dashboard/YOLO.
# Auto can fall back to authenticated HTTP snapshots if RTSP fails.
# If RTSP is unavailable, use CAMERA_VIDEO_BACKEND=http_snapshot.
CAMERA_VIDEO_BACKEND=auto
CAMERA_SNAPSHOT_URL=http://192.168.1.55:8090/cgi-bin/snapshot.jpg
CAMERA_SNAPSHOT_USERNAME=admin
CAMERA_SNAPSHOT_PASSWORD=
CAMERA_SNAPSHOT_INTERVAL_S=1.0
# Check ch1 (substream) with ffprobe first. If unavailable use ch0.
CAMERA_RTSP_URL=rtsp://192.168.1.55:554/ch1
CAMERA_ONVIF_HOST=192.168.1.55
CAMERA_ONVIF_PORT=80
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_AUDIO_ENABLED=true
CAMERA_MJPEG_WIDTH=640
CAMERA_MJPEG_FPS=12
CAMERA_JPEG_QUALITY=55
CAMERA_PAN_INVERT=false
CAMERA_TILT_INVERT=false
# Runtime reversals are also saved via Hombo3 UI (no reboot).

# Optional camera speaker instead of the default ESP32 MAX98357A.
# Requires hardware-tested /usr/bin/rac + play on camera and SSH key.
# SPEECH_OUTPUT=esp32
# CAMERA_SPEAKER_SSH_HOST=192.168.1.55
# CAMERA_SPEAKER_SSH_USER=root
# CAMERA_SPEAKER_SSH_KEY=/home/obzor/.ssh/hombo_t23n_ed25519
#
# IMPORTANT:
# - PegineLab HTTP JPEG requires a running CGI backend and valid Basic Auth.
# - RTSP credentials can differ from PegineLab Web UI credentials.
# - Microphone requires an AUDIO stream in RTSP (verify with ffprobe).
# - Speaker/talkback requires an RTSP ONVIF backchannel OR a separate verified
#   Raptor audio-output endpoint. It is NOT implied by audio_enabled=true.
# - Do not expose 8090/554/ONVIF/SSH ports to the Internet.

# Optional short microphone capture -> Windows FFmpeg -> STT on trusted CORE.
# DISABLED by default. Do not publish the operator token or STT API key.
# Install/run an OpenAI-compatible Whisper STT server on .100 FIRST;
# there is no confirmed STT listener/port on the CORE yet.
CAMERA_VOICE_ENABLED=false
CAMERA_VOICE_ACCESS_TOKEN=
CAMERA_STT_URL=
CAMERA_STT_API_KEY=
CAMERA_STT_MODEL=whisper-1
CAMERA_STT_LANGUAGE=ru
CAMERA_VOICE_CLIP_SECONDS=5
# TTS route to camera speaker (opt in only after acoustic test):
# SPEECH_OUTPUT=camera_ssh
# CAMERA_SPEAKER_SSH_HOST=192.168.1.55
# CAMERA_SPEAKER_SSH_USER=root
# CAMERA_SPEAKER_SSH_KEY=C:\\Users\\obzor\\.ssh\\hombo_t23n_ed25519
